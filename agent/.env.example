# Веб-интерфейс Next.js (локально: npm run dev в web-interface).
INGEST_URL=http://localhost:3000/api/logs/ingest
INGEST_TOKEN=

# Обучение: API-ключ вводится в UI и НЕ сохраняется на диск.
# В ~/.oko-efora/credentials.json остаётся только session_token (device-bound).
# Контракт сервера: contracts/auth-api.md
TRAINING_ENABLED=true
TRAINING_URL=http://localhost:8000/api/v1/train/logs
# Dev-override (не для пользователей):
# TRAINING_API_KEY=
# TRAINING_USER_ID=
TRAINING_FAIL_SOFT=true
# CREDENTIALS_PATH=~/.oko-efora/credentials.json

# Сброс: каждые BATCH_INTERVAL_SECONDS или раньше при BATCH_MAX_LOGS.
BATCH_INTERVAL_SECONDS=3
BATCH_MAX_LOGS=100
MAX_BUFFER_LOGS=10000

ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# auto — журнал ОС и файлы приложений
# journal — только журнал ОС (journald / unified log / Windows Event Log)
# files — только текстовые файлы
# all — журнал и файлы, включая syslog (возможны повторы)
LOG_SOURCES=auto
# end — только новые строки, start — короткая история и дальше слежение
READ_FROM=end

LINUX_LOG_ROOT=/var/log
EXTRA_LOG_PATHS=
MAX_TAIL_FILES=500
FILE_RESCAN_SECONDS=30
JOURNAL_BACKFILL=200

WINDOWS_CHANNELS=
WINDOWS_POLL_SECONDS=2
MACOS_LOG_LEVEL=debug

HTTP_TIMEOUT_SECONDS=10
HTTP_RETRY_SECONDS=2
COLLECTOR_RESTART_SECONDS=5
