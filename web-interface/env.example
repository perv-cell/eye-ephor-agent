# Публичное имя в UI (опционально).
NEXT_PUBLIC_APP_NAME=Око Эфора

# Центральный auth (лимит 2 устройства на ключ между ПК).
# Контракт: contracts/auth-api.md
# Пусто = локальный реестр в ~/.oko-efora/auth-registry.json
# AUTH_URL=https://api.example.com/api/v1/auth

# Локально (без сырого API-ключа):
# ~/.oko-efora/credentials.json  — session_token + device_id
# ~/.oko-efora/device.json
# ~/.oko-efora/auth-registry.json — hash(session), слоты устройств
